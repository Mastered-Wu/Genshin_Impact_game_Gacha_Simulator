file(GLOB_RECURSE frontend_files CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/../frontend/*")
set(resource_dir "${CMAKE_CURRENT_BINARY_DIR}/embedded")
file(MAKE_DIRECTORY "${resource_dir}")
set(resource_text "")
set(index_text "#pragma once\n#include <string>\ninline int frontendResourceId(const std::string& path) {\n")
set(resource_id 100)
foreach(asset IN LISTS frontend_files)
    file(RELATIVE_PATH asset_path "${CMAKE_CURRENT_SOURCE_DIR}/../frontend" "${asset}")
    configure_file("${asset}" "${resource_dir}/${asset_path}" COPYONLY)
    string(APPEND resource_text "${resource_id} RCDATA \"${asset_path}\"\n")
    string(APPEND index_text "    if (path == \"/${asset_path}\") return ${resource_id};\n")
    math(EXPR resource_id "${resource_id} + 1")
endforeach()
string(APPEND index_text "    return 0;\n}\n")
file(WRITE "${resource_dir}/frontend.rc" "${resource_text}")
file(WRITE "${resource_dir}/FrontendResources.h" "${index_text}")
